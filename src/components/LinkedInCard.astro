---
import { bio } from '../data/bio';
---

<a
  href={bio.linkedinUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${bio.linkedinLabel} (opens in new tab)`}
  class="reveal group block max-w-[480px] rounded-[14px] border border-border-subtle bg-surface overflow-hidden transition-all duration-200 ease-smooth hover:border-border-hover hover:-translate-y-0.5"
>
  <div
    class="relative h-20 bg-[#F4EFE7] bg-cover bg-center"
    style="background-image: url('/ai-network.svg');"
    role="img"
    aria-label="Abstract AI network graphic"
  >
    <span
      class="absolute top-3 right-3 inline-flex items-center justify-center w-7 h-7 rounded-md bg-[#0A66C2] text-white font-bold text-[11px] tracking-tight shadow-sm"
      aria-hidden="true"
    >
      in
    </span>
  </div>

  <div class="relative px-6 pb-6">
    <div
      class="absolute -top-10 left-6 w-20 h-20 rounded-full bg-surface ring-4 ring-surface overflow-hidden"
    >
      <div class="w-full h-full rounded-full overflow-hidden border border-border-subtle">
        {bio.photo ? (
          <img
            src={bio.photo}
            alt="Sujit Mohanty"
            width="80"
            height="80"
            class="w-full h-full object-cover"
          />
        ) : (
          <div
            class="w-full h-full flex items-center justify-center bg-gradient-to-br from-accent/15 to-accent/5"
            role="img"
            aria-label="Sujit Mohanty placeholder avatar"
          >
            <span class="font-display font-semibold text-[30px] tracking-tight text-accent">
              {bio.initial}
            </span>
          </div>
        )}
      </div>
    </div>

    <div class="pt-12">
      <div class="font-display font-semibold text-[20px] leading-[1.2] tracking-tight text-text-primary">
        Sujit Mohanty
      </div>
      <div class="mt-1.5 body-secondary text-[14.5px] leading-[1.5] max-w-[28rem]">
        {bio.headline}
      </div>
    </div>

    <div class="mt-5 inline-flex items-center gap-1.5 text-[12.5px] font-semibold uppercase tracking-[0.16em] text-text-primary transition-colors duration-200 ease-smooth group-hover:text-accent">
      {bio.linkedinLabel}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-3 h-3"
        aria-hidden="true"
      >
        <path d="M7 17 17 7" />
        <path d="M8 7h9v9" />
      </svg>
    </div>
  </div>
</a>
