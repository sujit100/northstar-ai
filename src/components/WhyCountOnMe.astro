---
import LinkedInCard from './LinkedInCard.astro';

const stats = [
  {
    eyebrow: 'Track record',
    value: '5 years',
    note: 'inside TikTok and Amazon',
  },
  {
    eyebrow: 'Reach',
    value: '1M+',
    note: 'sellers on TikTok Shop',
  },
  {
    eyebrow: 'Scale',
    value: '$100M+',
    note: 'in revenue unlocked at Amazon',
  },
];
---

<section
  id="why-me"
  class="section-pad"
  aria-labelledby="why-me-heading"
>
  <div class="container-page">
    <div class="reveal">
      <span class="label-eyebrow">Why count on me</span>
    </div>

    <h2
      id="why-me-heading"
      class="reveal mt-6 md:mt-8 heading-display text-[36px] sm:text-[46px] md:text-[56px] lg:text-[60px] tracking-tightest-3 max-w-[22ch]"
    >
      I've shipped AI to <span class="text-accent">millions.</span> Now I'm bringing it to your business.
    </h2>

    <div
      class="mt-10 md:mt-14 grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-14 lg:gap-20 items-start"
    >
      {/* Left: condensed summary + stats + link to full background */}
      <div class="lg:col-span-7">
        <p class="reveal body-text text-[18px] md:text-[20px] leading-[1.55] max-w-[60ch]">
          For the last few years I've worked inside the engine rooms of TikTok and
          Amazon, shipping AI features that millions of people rely on every day. Real
          systems running at scale, not slides in a deck — and that same discipline is
          what I bring to your business, at your scale, on your timeline.
        </p>

        <dl class="reveal mt-10 md:mt-12 grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8 max-w-[60ch]">
          {
            stats.map((stat) => (
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-[0.18em] text-accent">
                  {stat.eyebrow}
                </dt>
                <dd class="mt-3 font-display font-bold text-[32px] md:text-[36px] leading-[1] tracking-tightest-3 text-text-primary">
                  {stat.value}
                </dd>
                <dd class="mt-2 text-[13.5px] body-secondary leading-[1.45]">
                  {stat.note}
                </dd>
              </div>
            ))
          }
        </dl>

        <a
          href="/about/#background"
          class="reveal mt-10 md:mt-12 inline-flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[0.16em] text-text-primary link-quiet link-underline hover:text-accent"
        >
          Read the full background
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-3 h-3"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </a>
      </div>

      {/* Right: LinkedIn snippet card */}
      <div class="lg:col-span-5">
        <LinkedInCard />
      </div>
    </div>
  </div>
</section>
