---
const year = new Date().getFullYear();
---

<footer class="border-t border-border-subtle">
  <div class="container-page py-10 md:py-14 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <span class="inline-flex items-center gap-[8px]">
      <img
        src="/northstar-logo.svg"
        alt=""
        width="18"
        height="18"
        class="block shrink-0"
      />
      <span class="font-display font-bold text-[14px] text-text-primary">
        North Star AI
      </span>
    </span>

    <div class="flex items-center gap-6 text-[13.5px] text-text-secondary">
      <a
        href="https://www.linkedin.com/in/sujitkmohanty/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn (opens in new tab)"
        class="link-quiet link-underline inline-flex items-center gap-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4 h-4"
        >
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
          <rect width="4" height="12" x="2" y="9" />
          <circle cx="4" cy="4" r="2" />
        </svg>
        <span>LinkedIn</span>
      </a>
      <span>© {year}</span>
    </div>
  </div>
</footer>
