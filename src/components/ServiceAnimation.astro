<script>
  const els = document.querySelectorAll<HTMLElement>('[data-service-anim]');
  if ('IntersectionObserver' in window && els.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.removeAttribute('data-pause');
          else entry.target.setAttribute('data-pause', 'true');
        });
      },
      { threshold: 0, rootMargin: '64px 0px' }
    );
    els.forEach((el) => io.observe(el));
  }
</script>
