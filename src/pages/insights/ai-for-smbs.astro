---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const title = 'AI for SMBs · Northstar AI';
const description =
  'A data-driven snapshot of how small and medium businesses are using AI in 2026 — adoption, spend, ROI, and the gap between what non-adopters believe and what adopters report.';

const adoptionByYear = [
  { year: '2023', pct: 36 },
  { year: '2024', pct: 42 },
  { year: '2025', pct: 57 },
];

const tools = [
  { name: 'ChatGPT', pct: 60.0 },
  { name: 'Microsoft Copilot', pct: 14.3 },
  { name: 'Google Gemini', pct: 13.5 },
  { name: 'Perplexity', pct: 6.2 },
  { name: 'Anthropic Claude', pct: 3.2 },
];

const functions = [
  { label: 'Marketing & content', pct: 53 },
  { label: 'Sales & lead generation', pct: 49 },
  { label: 'Customer service', pct: 46 },
  { label: 'Communications & writing', pct: 28 },
  { label: 'Accounting & admin', pct: 25 },
  { label: 'Workflow automation', pct: 24 },
  { label: 'Recruitment & HR', pct: 19 },
  { label: 'Meetings & note capture', pct: 17 },
];

const misconceptions = [
  {
    belief: '"AI is too expensive for a business my size."',
    held: '62%',
    reality:
      'Most SMBs run a real AI stack for $20–$200 per user per month — comparable to a phone plan. ChatGPT Plus is $20. Copilot is $30.',
  },
  {
    belief: '"AI doesn\'t apply to my industry."',
    held: '82%',
    reality:
      'Only 8% of adopters across industries — plumbing, legal, retail, medical — report AI failed to apply meaningfully.',
  },
  {
    belief: '"I need a data scientist to use AI."',
    held: '60%',
    reality:
      '84% of SMB adopters deployed their first tool with no specialized hire and no consultant.',
  },
  {
    belief: '"AI will replace my employees."',
    held: '53%',
    reality:
      '13.7% of adopting firms increased headcount; only 6.9% reduced. AI is filling roles owners couldn\'t hire for.',
  },
];
---

<Layout title={title} description={description}>
  <Nav />
  <main class="pt-28 md:pt-36 pb-24 md:pb-32">
    {/* ============ Header ============ */}
    <header class="container-page reveal">
      <a
        href="/#insights"
        class="inline-flex items-center gap-2 text-[12px] font-semibold uppercase tracking-[0.18em] text-text-secondary link-quiet hover:text-accent"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3" aria-hidden="true">
          <path d="m15 18-6-6 6-6" />
        </svg>
        Insights
      </a>

      <h1 class="mt-6 md:mt-8 heading-display text-[44px] sm:text-[60px] md:text-[76px] lg:text-[92px] tracking-tightest-3 max-w-[18ch]">
        The SMB AI <span class="text-accent">opportunity.</span>
      </h1>

      <p class="mt-7 md:mt-9 max-w-[60ch] text-[18px] md:text-[20px] body-secondary leading-[1.55]">
        After two years of cautious experimentation, AI has crossed from novelty to
        infrastructure for a meaningful share of the SMB economy. Here is what the
        2025–2026 data shows about adoption, spend, ROI — and the gap between what
        non-adopters believe and what adopters actually report.
      </p>

      <div class="mt-8 md:mt-10 flex flex-wrap items-center gap-x-6 gap-y-2 text-[12px] font-semibold uppercase tracking-[0.18em] text-text-secondary">
        <span>Northstar AI · Research</span>
        <span aria-hidden="true">·</span>
        <span>Updated 2026</span>
        <span aria-hidden="true">·</span>
        <span>~7 min read</span>
      </div>
    </header>

    <div class="container-page mt-16 md:mt-20">
      <div class="divider-hairline" />
    </div>

    {/* ============ Section 1: Headline numbers ============ */}
    <section class="container-page mt-20 md:mt-28 reveal" aria-labelledby="headline">
      <span class="label-eyebrow">01 · The state of adoption</span>
      <h2 id="headline" class="mt-6 md:mt-8 heading-display text-[32px] sm:text-[42px] md:text-[52px] tracking-tightest-3 max-w-[20ch]">
        Adoption has roughly doubled in two years.
      </h2>

      <div class="mt-12 md:mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <div class="rounded-[12px] border border-border-subtle bg-surface p-7 md:p-8">
          <span class="label-eyebrow text-accent">Investment</span>
          <p class="mt-3 font-display font-bold text-[60px] md:text-[72px] leading-none tracking-tightest-3 text-text-primary">57<span class="text-accent">%</span></p>
          <p class="mt-3 text-[14px] body-secondary leading-[1.55]">
            of U.S. SMBs invested in AI in 2025, up from 36% in 2023 — a 58% jump in two years.
          </p>
        </div>

        <div class="rounded-[12px] border border-border-subtle bg-surface p-7 md:p-8">
          <span class="label-eyebrow text-accent">Revenue</span>
          <p class="mt-3 font-display font-bold text-[60px] md:text-[72px] leading-none tracking-tightest-3 text-text-primary">91<span class="text-accent">%</span></p>
          <p class="mt-3 text-[14px] body-secondary leading-[1.55]">
            of AI-using SMBs report revenue gains. 86% report improved margins.
          </p>
        </div>

        <div class="rounded-[12px] border border-border-subtle bg-surface p-7 md:p-8">
          <span class="label-eyebrow text-accent">Time saved</span>
          <p class="mt-3 font-display font-bold text-[60px] md:text-[72px] leading-none tracking-tightest-3 text-text-primary">5.6<span class="text-[40px] md:text-[48px] text-accent">h</span></p>
          <p class="mt-3 text-[14px] body-secondary leading-[1.55]">
            saved per worker per week using AI. 58% of adopters save 20+ hours per month.
          </p>
        </div>
      </div>
    </section>

    {/* ============ Section 2: Adoption growth chart ============ */}
    <section class="container-page mt-24 md:mt-32 reveal" aria-labelledby="adoption-chart">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end">
        <div class="lg:col-span-5">
          <span class="label-eyebrow">Figure 01 · Investment growth</span>
          <h3 id="adoption-chart" class="mt-5 font-display font-semibold text-[26px] md:text-[32px] leading-[1.2] tracking-tight max-w-[18ch]">
            Two years of compounding growth.
          </h3>
          <p class="mt-4 body-secondary text-[15.5px] leading-[1.6] max-w-[42ch]">
            The longitudinal business.com / Dialog survey of 1,009 SMB workers tracks AI
            investment year over year. Acceleration, not plateau.
          </p>
        </div>

        <div class="lg:col-span-7">
          <div class="rounded-[12px] border border-border-subtle bg-surface p-7 md:p-9">
            <svg viewBox="0 0 480 280" class="block w-full h-auto" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="SMB AI investment 2023 36%, 2024 42%, 2025 57%">
              {/* horizontal grid lines */}
              {[0, 20, 40, 60].map((v) => (
                <g>
                  <line x1="60" y1={240 - v * 3.6} x2="460" y2={240 - v * 3.6} stroke="#E5E5E0" stroke-width="1" stroke-dasharray="2 4" />
                  <text x="48" y={240 - v * 3.6 + 4} text-anchor="end" font-size="10" font-family="Inter, system-ui, sans-serif" fill="#9CA3AF">{v}%</text>
                </g>
              ))}
              {/* bars */}
              {adoptionByYear.map((d, i) => {
                const x = 100 + i * 130;
                const h = d.pct * 3.6;
                const y = 240 - h;
                return (
                  <g>
                    <rect x={x} y={y} width="80" height={h} rx="4" fill="#C2410C" fill-opacity={0.7 + i * 0.15} class="insight-bar-v" style={`animation-delay: ${i * 0.18}s`} />
                    <text x={x + 40} y={y - 10} text-anchor="middle" font-size="14" font-weight="700" font-family="Inter Tight, system-ui, sans-serif" fill="#0A0A0A">{d.pct}%</text>
                    <text x={x + 40} y="262" text-anchor="middle" font-size="11" font-weight="600" font-family="Inter, system-ui, sans-serif" fill="#4B4B4B">{d.year}</text>
                  </g>
                );
              })}
              <text x="240" y="20" text-anchor="middle" font-size="10" font-weight="700" letter-spacing="1.6" font-family="Inter, system-ui, sans-serif" fill="#9CA3AF">% OF SMBs INVESTING IN AI</text>
            </svg>
            <p class="mt-4 text-[12px] text-text-secondary">Source: business.com / Dialog longitudinal survey, 1,009 U.S. SMB workers.</p>
          </div>
        </div>
      </div>
    </section>

    {/* ============ Section 3: Closing the enterprise gap ============ */}
    <section class="container-page mt-24 md:mt-32 reveal" aria-labelledby="enterprise-gap">
      <span class="label-eyebrow">02 · The enterprise gap</span>
      <h2 id="enterprise-gap" class="mt-6 md:mt-8 heading-display text-[32px] sm:text-[42px] md:text-[52px] tracking-tightest-3 max-w-[22ch]">
        The gap with large enterprises is closing fast.
      </h2>

      <div class="mt-10 md:mt-12 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
        <div class="max-w-[55ch]">
          <p class="body-text text-[16.5px] md:text-[17.5px] leading-[1.7]">
            In every prior major technology cycle — broadband, cloud, mobile — small
            businesses lagged enterprises by years. With AI, the U.S. Census Bureau's
            BTOS data shows the adoption ratio compressing from <strong class="text-accent">1.8×</strong> to roughly <strong class="text-accent">1.2×</strong> in eighteen months. Cloud-delivered tools require no
            infrastructure, no specialized hires, and no procurement cycles. The SBA
            estimates SMBs are now twelve months behind.
          </p>
        </div>

        <div class="rounded-[12px] border border-border-subtle bg-surface p-7 md:p-9">
          <span class="label-eyebrow">Figure 02 · Adoption rate by firm size</span>
          <svg viewBox="0 0 460 220" class="mt-4 block w-full h-auto" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Census BTOS adoption rates Feb 2024 vs Aug 2025">
            {/* Feb 2024 group */}
            <text x="100" y="200" text-anchor="middle" font-size="11" font-weight="600" font-family="Inter, system-ui, sans-serif" fill="#4B4B4B">Feb 2024</text>
            <rect x="60" y={180 - 6.3 * 12} width="36" height={6.3 * 12} rx="3" fill="#E5E5E0" class="insight-bar-v" style="animation-delay: 0s" />
            <rect x="104" y={180 - 11.1 * 12} width="36" height={11.1 * 12} rx="3" fill="#C2410C" class="insight-bar-v" style="animation-delay: 0.1s" />
            <text x="78" y={180 - 6.3 * 12 - 6} text-anchor="middle" font-size="10" font-weight="700" font-family="Inter Tight, system-ui, sans-serif" fill="#0A0A0A">6.3%</text>
            <text x="122" y={180 - 11.1 * 12 - 6} text-anchor="middle" font-size="10" font-weight="700" font-family="Inter Tight, system-ui, sans-serif" fill="#0A0A0A">11.1%</text>

            {/* Aug 2025 group */}
            <text x="320" y="200" text-anchor="middle" font-size="11" font-weight="600" font-family="Inter, system-ui, sans-serif" fill="#4B4B4B">Aug 2025</text>
            <rect x="280" y={180 - 8.8 * 12} width="36" height={8.8 * 12} rx="3" fill="#E5E5E0" class="insight-bar-v" style="animation-delay: 0.4s" />
            <rect x="324" y={180 - 10.5 * 12} width="36" height={10.5 * 12} rx="3" fill="#C2410C" class="insight-bar-v" style="animation-delay: 0.5s" />
            <text x="298" y={180 - 8.8 * 12 - 6} text-anchor="middle" font-size="10" font-weight="700" font-family="Inter Tight, system-ui, sans-serif" fill="#0A0A0A">8.8%</text>
            <text x="342" y={180 - 10.5 * 12 - 6} text-anchor="middle" font-size="10" font-weight="700" font-family="Inter Tight, system-ui, sans-serif" fill="#0A0A0A">10.5%</text>

            {/* Legend */}
            <rect x="60" y="20" width="10" height="10" rx="2" fill="#E5E5E0" />
            <text x="76" y="29" font-size="10" font-family="Inter, system-ui, sans-serif" fill="#4B4B4B">Small firms</text>
            <rect x="160" y="20" width="10" height="10" rx="2" fill="#C2410C" />
            <text x="176" y="29" font-size="10" font-family="Inter, system-ui, sans-serif" fill="#4B4B4B">Large firms (250+)</text>

            {/* Baseline */}
            <line x1="50" y1="180" x2="410" y2="180" stroke="#E5E5E0" stroke-width="1" />
          </svg>
          <p class="mt-4 text-[12px] text-text-secondary">Source: U.S. Census Bureau, Business Trends and Outlook Survey, AI supplement.</p>
        </div>
      </div>
    </section>

    {/* ============ Section 4: What SMBs are using ============ */}
    <section class="container-page mt-24 md:mt-32 reveal" aria-labelledby="tools">
      <span class="label-eyebrow">03 · The stack</span>
      <h2 id="tools" class="mt-6 md:mt-8 heading-display text-[32px] sm:text-[42px] md:text-[52px] tracking-tightest-3 max-w-[22ch]">
        ChatGPT is the gateway. The stack broadens from there.
      </h2>

      <div class="mt-10 md:mt-12 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-5 max-w-[55ch]">
          <p class="body-text text-[16.5px] md:text-[17.5px] leading-[1.7]">
            For most SMBs, ChatGPT is the first AI tool they touch — typically through
            the free or $20 Plus tier. Microsoft Copilot and Google Gemini grow more
            quietly through bundled productivity software. After 6–12 months, most
            adopters layer specialized tools on top: writing assistants, scheduling
            agents, automation platforms.
          </p>
        </div>

        <div class="lg:col-span-7">
          <div class="rounded-[12px] border border-border-subtle bg-surface p-7 md:p-9">
            <span class="label-eyebrow">Figure 03 · Generative AI chatbot share, 2025</span>
            <div class="mt-6 space-y-4">
              {tools.map((t) => (
                <div>
                  <div class="flex items-baseline justify-between gap-4">
                    <span class="text-[14px] md:text-[15px] font-semibold text-text-primary">{t.name}</span>
                    <span class="font-display font-bold text-[15px] md:text-[16px] tracking-tight text-text-primary">{t.pct}%</span>
                  </div>
                  <div class="mt-2 h-[10px] w-full rounded-full bg-divider overflow-hidden">
                    <div
                      class="insight-bar-h h-full rounded-full bg-accent"
                      style={`width: ${t.pct}%`}
                    />
                  </div>
                </div>
              ))}
            </div>
            <p class="mt-6 text-[12px] text-text-secondary">Source: industry tracking of generative AI chatbot usage, 2025.</p>
          </div>
        </div>
      </div>
    </section>

    {/* ============ Section 5: Where AI is being deployed ============ */}
    <section class="container-page mt-24 md:mt-32 reveal" aria-labelledby="functions">
      <span class="label-eyebrow">04 · Where AI is deployed</span>
      <h2 id="functions" class="mt-6 md:mt-8 heading-display text-[32px] sm:text-[42px] md:text-[52px] tracking-tightest-3 max-w-[22ch]">
        Marketing leads. The highest-ROI work sits deeper.
      </h2>

      <div class="mt-10 md:mt-12 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-7">
          <div class="rounded-[12px] border border-border-subtle bg-surface p-7 md:p-9">
            <span class="label-eyebrow">Figure 04 · Function-level adoption</span>
            <div class="mt-6 space-y-3.5">
              {functions.map((f) => (
                <div>
                  <div class="flex items-baseline justify-between gap-4">
                    <span class="text-[13.5px] md:text-[14.5px] font-medium text-text-primary">{f.label}</span>
                    <span class="font-display font-bold text-[14px] md:text-[15px] tracking-tight text-text-primary">{f.pct}%</span>
                  </div>
                  <div class="mt-1.5 h-[8px] w-full rounded-full bg-divider overflow-hidden">
                    <div
                      class="insight-bar-h h-full rounded-full bg-accent/85"
                      style={`width: ${f.pct}%`}
                    />
                  </div>
                </div>
              ))}
            </div>
            <p class="mt-6 text-[12px] text-text-secondary">Source: Verizon, Salesforce, Service Direct surveys, 2025.</p>
          </div>
        </div>

        <div class="lg:col-span-5 max-w-[50ch]">
          <p class="body-text text-[16.5px] md:text-[17.5px] leading-[1.7]">
            Marketing and content lead because they're the most accessible entry points.
            The real ROI tends to compound deeper in the stack — workflow automation,
            document intelligence, business analytics — where the work is more
            repeatable and the payoff is more measurable.
          </p>
          <p class="mt-5 body-secondary text-[15px] leading-[1.65]">
            Among growing SMBs, 83% are at least experimenting with AI; 78% plan to
            increase their AI investment in the coming year — versus 55% of declining
            peers. The companies pulling ahead are doubling down.
          </p>
        </div>
      </div>
    </section>

    {/* ============ Section 6: Misconception vs reality ============ */}
    <section class="container-page mt-24 md:mt-32 reveal" aria-labelledby="misconceptions">
      <span class="label-eyebrow">05 · The perception gap</span>
      <h2 id="misconceptions" class="mt-6 md:mt-8 heading-display text-[32px] sm:text-[42px] md:text-[52px] tracking-tightest-3 max-w-[22ch]">
        The barriers are mostly in the head, not the wallet.
      </h2>

      <p class="mt-6 md:mt-8 max-w-[60ch] body-secondary text-[16.5px] md:text-[17.5px] leading-[1.65]">
        Among the smallest non-adopters, <strong class="text-text-primary">82%</strong> say AI doesn't apply to their business.
        Among similar businesses that did adopt, only <strong class="text-accent">8%</strong> report that AI failed to apply.
        The applicability gap is almost entirely an awareness gap.
      </p>

      <div class="mt-12 md:mt-16 grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {misconceptions.map((m, i) => (
          <article class="rounded-[12px] border border-border-subtle bg-surface p-7 md:p-8">
            <span class="block text-[10.5px] font-semibold uppercase tracking-[0.18em] text-text-secondary">
              Misconception {String(i + 1).padStart(2, '0')}
            </span>
            <p class="mt-3 font-display font-semibold text-[18px] md:text-[20px] leading-[1.3] tracking-tight text-text-primary">
              {m.belief}
            </p>
            <p class="mt-2 text-[13px] body-secondary">Held by <strong class="text-text-primary">{m.held}</strong> of non-adopters</p>

            <div class="mt-6 pt-6 border-t border-border-subtle">
              <span class="block text-[10.5px] font-semibold uppercase tracking-[0.18em] text-accent">
                What adopters report
              </span>
              <p class="mt-3 text-[14.5px] body-text leading-[1.6]">
                {m.reality}
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* ============ Section 7: What's next ============ */}
    <section class="container-page mt-24 md:mt-32 reveal" aria-labelledby="next">
      <span class="label-eyebrow">06 · What to do now</span>
      <h2 id="next" class="mt-6 md:mt-8 heading-display text-[32px] sm:text-[42px] md:text-[52px] tracking-tightest-3 max-w-[22ch]">
        Pick one workflow. Ship in thirty days. Expand from there.
      </h2>

      <div class="mt-10 md:mt-12 max-w-[60ch] body-text text-[16.5px] md:text-[17.5px] leading-[1.7] space-y-5">
        <p>
          The path forward isn't complicated. The SMBs capturing the most value follow a
          recognizable pattern: pick one repeatable workflow, deploy AI to handle it,
          measure obsessively, expand. The first project should be narrow enough to
          prove the model and visible enough to compound trust.
        </p>
        <p>
          Modern tools integrate cleanly with the systems most SMBs already run on —
          QuickBooks, Shopify, HubSpot, Google Workspace, Microsoft 365. Costs scale
          predictably with users. The bandwidth to begin is the only thing that's
          actually scarce.
        </p>
      </div>

      <div class="mt-12 md:mt-14 flex flex-wrap gap-4">
        <a href="/#services" class="inline-flex items-center gap-2 bg-text-primary text-background px-6 py-3.5 text-[14px] font-medium rounded-full transition-colors duration-200 ease-smooth hover:bg-accent">
          See the six ways I help SMBs deploy AI
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5" aria-hidden="true">
            <path d="m9 6 6 6-6 6" />
          </svg>
        </a>
        <a href="/#book" class="inline-flex items-center gap-2 border border-border-subtle px-6 py-3.5 text-[14px] font-medium rounded-full transition-colors duration-200 ease-smooth hover:border-border-hover hover:text-accent">
          Book a 30-minute conversation
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
